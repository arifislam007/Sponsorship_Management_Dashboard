DB_HOST=localhost
DB_PORT=5432
DB_USER=sombhabona_user
DB_PASSWORD=sombhabona_pass
DB_NAME=sombhabona_db
JWT_SECRET=your_jwt_secret_key_here
PORT=5006
NODE_ENV=development
GOOGLE_SERVICE_ACCOUNT_JSON=

# OpenWA (self-hosted WhatsApp gateway) integration
# Base REST API URL for the running OpenWA instance
OPENWA_API_URL=https://chat.sombhabona.org/api
# API key issued by the OpenWA instance for authenticating outbound requests
OPENWA_API_KEY=replace-with-real-openwa-api-key
# The OpenWA session ID to send/receive messages through
OPENWA_SESSION_ID=replace-with-real-session-id
# Shared secret used to verify the X-OpenWA-Signature HMAC header on incoming webhooks
OPENWA_WEBHOOK_SECRET=replace-with-real-webhook-secret
